# Copy to server/.env for local runs; on Render set these under Environment.

NODE_ENV=production
PORT=5000

# Long random string used to sign login tokens (e.g. `openssl rand -hex 32`).
# REQUIRED in production (32+ characters): the server refuses to start without it.
JWT_SECRET=

# Database. Render's free plan wipes the server's disk on every deploy and every
# time it sleeps, so set this there or accounts and progress keep disappearing.
# Free MongoDB Atlas cluster: https://www.mongodb.com/cloud/atlas (M0 Free). Create a
# database user, allow access from anywhere (0.0.0.0/0) under Network Access, then
# copy the connection string (Connect > Drivers) with your password filled in.
# Without it, data is kept in the JSON files in server/data (fine for local runs).
# REQUIRED in production: the server refuses to start without it, unless
# ALLOW_FILE_STORAGE=1 (only for hosts with a persistent disk).
# To copy existing local data into the database once: node server/scripts/import-to-mongo.js
MONGODB_URI=
# MONGODB_DB=examprep

# Google sign-in: OAuth 2.0 Client ID (type "Web application") from
# https://console.cloud.google.com/apis/credentials
# Add your site URL (and http://localhost:5173 for development) under
# "Authorized JavaScript origins". Without it, development uses a demo login
# and production hides Google sign-in.
GOOGLE_CLIENT_ID=

# Email for sign-up codes and password resets. Without either option below,
# development prints codes in the server log and production turns email off.
#
# Option 1 (use this on Render's free tier, which blocks outbound SMTP):
# Brevo's HTTPS API. Free at https://www.brevo.com (300 emails a day). Create an
# API key under SMTP & API > API Keys, and add MAIL_FROM's address under
# Senders, domains & IPs > Senders (a Gmail address is fine; Brevo emails it a
# confirmation link).
BREVO_API_KEY=
MAIL_FROM=ExamPrep <you@gmail.com>
#
# Option 2 (paid Render instance or other hosts): Gmail SMTP.
# SMTP_USER is the Gmail address; SMTP_PASS is a 16-character App Password from
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Site address used in the "Set a new password" link in reset emails.
# On Render this defaults to the service's own URL (RENDER_EXTERNAL_URL);
# set it if you use a custom domain.
# APP_URL=https://examprep-platform.onrender.com

# Extra sites allowed to call the API from a browser (comma-separated, exact
# origins). The app itself is served from the same address and needs nothing here.
# CORS_ORIGIN=https://www.example.com

# Cloudflare Turnstile bot check on sign-up and password reset (free).
# Cloudflare dashboard > Turnstile > Add widget, add your site's domain (e.g.
# examprep-platform.onrender.com), Managed mode, then copy both keys.
# Without them the check is off. For local testing use Cloudflare's test keys,
# which always pass: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated developer emails: they can see and resolve every issue report,
# and each new report is emailed to them (needs the email settings above)
ADMIN_EMAILS=
