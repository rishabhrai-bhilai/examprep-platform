<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 520 280" width="520" height="280">
  <rect width="100%" height="100%" fill="#ffffff" rx="12"/>
  <text x="260" y="30" font-family="sans-serif" font-size="14" font-weight="bold" fill="#1e293b" text-anchor="middle">Three 2-to-1 Multiplexer Circuit</text>

  <g stroke="#2563eb" stroke-width="2" fill="#eff6ff">
    <polygon points="120,60 180,75 180,125 120,140" />
    <text x="145" y="105" font-family="sans-serif" font-size="13" font-weight="bold" fill="#1e293b">M1</text>
  </g>
  <text x="70" y="80" font-family="sans-serif" font-size="13" font-weight="bold" fill="#0f172a">X1=1</text>
  <text x="70" y="125" font-family="sans-serif" font-size="13" font-weight="bold" fill="#0f172a">X2=1</text>
  <text x="145" y="160" font-family="sans-serif" font-size="13" font-weight="bold" fill="#dc2626">Sel: A</text>

  <g stroke="#2563eb" stroke-width="2" fill="#eff6ff">
    <polygon points="120,180 180,195 180,245 120,260" />
    <text x="145" y="225" font-family="sans-serif" font-size="13" font-weight="bold" fill="#1e293b">M2</text>
  </g>
  <text x="70" y="200" font-family="sans-serif" font-size="13" font-weight="bold" fill="#0f172a">X3=0</text>
  <text x="70" y="245" font-family="sans-serif" font-size="13" font-weight="bold" fill="#0f172a">X4=0</text>
  <text x="145" y="278" font-family="sans-serif" font-size="13" font-weight="bold" fill="#dc2626">Sel: B</text>

  <g stroke="#2563eb" stroke-width="2" fill="#dbeafe">
    <polygon points="320,120 380,135 380,185 320,200" />
    <text x="345" y="165" font-family="sans-serif" font-size="13" font-weight="bold" fill="#1e293b">M3</text>
  </g>
  <text x="345" y="220" font-family="sans-serif" font-size="13" font-weight="bold" fill="#dc2626">Sel: C</text>

  <g stroke="#334155" stroke-width="2.5" fill="none">
    <line x1="180" y1="100" x2="320" y2="140" />
    <text x="240" y="110" font-family="sans-serif" font-size="12" font-weight="bold" fill="#475569">Q1</text>
    <line x1="180" y1="220" x2="320" y2="180" />
    <text x="240" y="215" font-family="sans-serif" font-size="12" font-weight="bold" fill="#475569">Q2</text>
    <line x1="380" y1="160" x2="440" y2="160" stroke="#2563eb" stroke-width="3"/>
  </g>
  <text x="455" y="166" font-family="sans-serif" font-size="18" font-weight="bold" fill="#2563eb">Y</text>
</svg>