<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 260" width="500" height="260">
  <rect width="100%" height="100%" fill="#ffffff" rx="12"/>
  <text x="250" y="25" font-family="sans-serif" font-size="14" font-weight="bold" fill="#1e293b" text-anchor="middle">Electricity Generation Share: 2007 vs 2023</text>
  
  <g transform="translate(130, 130)">
    <circle cx="0" cy="0" r="65" fill="#e2e8f0"/>
    <path d="M 0,0 L 0,-65 A 65,65 0 0,1 38,53 Z" fill="#10b981"/>
    <text x="0" y="90" font-family="sans-serif" font-size="13" font-weight="bold" fill="#1e293b" text-anchor="middle">2007 (40% Renewables)</text>
  </g>

  <g transform="translate(370, 130)">
    <circle cx="0" cy="0" r="65" fill="#e2e8f0"/>
    <path d="M 0,0 L 0,-65 A 65,65 0 1,1 -53,38 Z" fill="#10b981"/>
    <text x="0" y="90" font-family="sans-serif" font-size="13" font-weight="bold" fill="#1e293b" text-anchor="middle">2023 (65% Renewables)</text>
  </g>
</svg>