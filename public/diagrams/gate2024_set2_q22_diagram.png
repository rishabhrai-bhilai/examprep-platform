<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 460 220" width="460" height="220">
  <rect width="100%" height="100%" fill="#ffffff" rx="12"/>
  <text x="230" y="30" font-family="sans-serif" font-size="14" font-weight="bold" fill="#1e293b" text-anchor="middle">DFA State Transition Diagram</text>

  <g stroke="#1e293b" stroke-width="2" fill="#f8fafc" font-family="sans-serif" font-size="15" font-weight="bold" text-anchor="middle">
    <line x1="60" y1="120" x2="100" y2="120" stroke="#1e293b" stroke-width="2"/>
    <polygon points="100,120 90,115 90,125" fill="#1e293b"/>
    <circle cx="130" cy="120" r="26" fill="#dbeafe"/>
    <text x="130" y="126">q0</text>
    <circle cx="330" cy="120" r="26" fill="#dcfce7"/>
    <circle cx="330" cy="120" r="21" fill="none" stroke="#16a34a" stroke-width="2"/>
    <text x="330" y="126">q1</text>
  </g>

  <g stroke="#334155" stroke-width="2" fill="none" font-family="sans-serif" font-size="13" font-weight="bold" fill="#0f172a">
    <path d="M 120,95 C 100,50 160,50 140,95" />
    <text x="130" y="58" text-anchor="middle">0</text>
    <path d="M 155,110 Q 230,85 305,110" />
    <text x="230" y="88" text-anchor="middle">1</text>
    <path d="M 305,130 Q 230,155 155,130" />
    <text x="230" y="156" text-anchor="middle">1</text>
    <path d="M 320,95 C 300,50 360,50 340,95" />
    <text x="330" y="58" text-anchor="middle">0</text>
  </g>
</svg>