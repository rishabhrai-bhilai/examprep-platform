<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 360" width="360" height="360">
  <rect width="100%" height="100%" fill="#ffffff" rx="12"/>
  <text x="180" y="30" font-family="sans-serif" font-size="15" font-weight="bold" fill="#1e293b" text-anchor="middle">4 × 4 Grid Puzzle</text>
  
  <g stroke="#334155" stroke-width="2" fill="#f8fafc" font-family="sans-serif" font-size="18" font-weight="bold" text-anchor="middle">
    <rect x="60" y="60" width="60" height="60" fill="#fee2e2"/><text x="90" y="97" fill="#dc2626">X</text>
    <rect x="120" y="60" width="60" height="60" /><text x="150" y="97" fill="#1e293b">3</text>
    <rect x="180" y="60" width="60" height="60" fill="#fee2e2"/><text x="210" y="97" fill="#dc2626">X</text>
    <rect x="240" y="60" width="60" height="60" /><text x="270" y="97" fill="#1e293b">2</text>
    
    <rect x="60" y="120" width="60" height="60" /><text x="90" y="157" fill="#1e293b">3</text>
    <rect x="120" y="120" width="60" height="60" fill="#fee2e2"/><text x="150" y="157" fill="#dc2626">X</text>
    <rect x="180" y="120" width="60" height="60" /><text x="210" y="157" fill="#1e293b">5</text>
    <rect x="240" y="120" width="60" height="60" /><text x="270" y="157" fill="#1e293b">4</text>
    
    <rect x="60" y="180" width="60" height="60" /><text x="90" y="217" fill="#1e293b">3</text>
    <rect x="120" y="180" width="60" height="60" fill="#fee2e2"/><text x="150" y="217" fill="#dc2626">X</text>
    <rect x="180" y="180" width="60" height="60" /><text x="210" y="217" fill="#1e293b">6</text>
    <rect x="240" y="180" width="60" height="60" fill="#fee2e2"/><text x="270" y="217" fill="#dc2626">X</text>
    
    <rect x="60" y="240" width="60" height="60" fill="#dbeafe"/><text x="90" y="277" fill="#2563eb">?</text>
    <rect x="120" y="240" width="60" height="60" fill="#dbeafe"/><text x="150" y="277" fill="#2563eb">?</text>
    <rect x="180" y="240" width="60" height="60" fill="#dbeafe"/><text x="210" y="277" fill="#2563eb">?</text>
    <rect x="240" y="240" width="60" height="60" fill="#dbeafe"/><text x="270" y="277" fill="#2563eb">?</text>
  </g>
</svg>