<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 420 280" width="420" height="280">
  <rect width="100%" height="100%" fill="#ffffff" rx="12"/>
  <line x1="40" y1="140" x2="380" y2="140" stroke="#dc2626" stroke-width="3" stroke-dasharray="6,4"/>
  <text x="20" y="145" font-family="sans-serif" font-size="16" font-weight="bold" fill="#dc2626">A</text>
  <text x="395" y="145" font-family="sans-serif" font-size="16" font-weight="bold" fill="#dc2626">B</text>

  <g stroke="#334155" stroke-width="2" fill="#93c5fd">
    <rect x="130" y="100" width="40" height="40" />
    <rect x="170" y="100" width="40" height="40" />
    <rect x="210" y="100" width="40" height="40" />
    <rect x="170" y="60" width="40" height="40" />
    <rect x="170" y="140" width="40" height="40" />
    <rect x="250" y="140" width="40" height="40" />
  </g>
  <text x="210" y="240" font-family="sans-serif" font-size="13" font-weight="bold" fill="#475569" text-anchor="middle">Add minimum squares to make AB a line of symmetry</text>
</svg>