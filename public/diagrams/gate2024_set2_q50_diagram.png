<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 520 240" width="520" height="240">
  <rect width="100%" height="100%" fill="#ffffff" rx="12"/>
  <text x="260" y="26" font-family="sans-serif" font-size="14" font-weight="bold" fill="#1e293b" text-anchor="middle">Logic Circuit for Output Y</text>

  <g stroke="#1e293b" stroke-width="2.5" fill="none">
    <!-- Input lines top (f1, f2) -->
    <line x1="40" y1="65" x2="130" y2="65"/>
    <line x1="40" y1="95" x2="130" y2="95"/>

    <!-- AND Gate top -->
    <path d="M 130,50 L 165,50 A 30,30 0 0 1 165,110 L 130,110 Z" fill="#f8fafc" stroke="#1e293b" stroke-width="2.5"/>

    <!-- Input lines bottom (f3, f4) -->
    <line x1="40" y1="155" x2="130" y2="155"/>
    <line x1="40" y1="185" x2="130" y2="185"/>

    <!-- OR Gate bottom -->
    <path d="M 130,140 Q 145,170 130,200 Q 170,200 195,170 Q 170,140 130,140 Z" fill="#f8fafc" stroke="#1e293b" stroke-width="2.5"/>

    <!-- Connecting lines to XOR -->
    <line x1="195" y1="80" x2="270" y2="80"/>
    <line x1="270" y1="80" x2="270" y2="110"/>
    <line x1="270" y1="110" x2="310" y2="110"/>

    <line x1="195" y1="170" x2="270" y2="170"/>
    <line x1="270" y1="170" x2="270" y2="140"/>
    <line x1="270" y1="140" x2="310" y2="140"/>

    <!-- XOR Gate -->
    <path d="M 302,95 Q 317,125 302,155" fill="none" stroke="#1e293b" stroke-width="2.5"/>
    <path d="M 310,95 Q 325,125 310,155 Q 350,155 375,125 Q 350,95 310,95 Z" fill="#f8fafc" stroke="#1e293b" stroke-width="2.5"/>

    <!-- Output wire -->
    <line x1="375" y1="125" x2="450" y2="125"/>
  </g>

  <!-- Labels -->
  <g font-family="sans-serif" font-size="14" font-weight="bold" fill="#0f172a">
    <text x="30" y="70" text-anchor="end">f₁</text>
    <text x="30" y="100" text-anchor="end">f₂</text>
    <text x="30" y="160" text-anchor="end">f₃</text>
    <text x="30" y="190" text-anchor="end">f₄</text>

    <text x="150" y="85" font-size="11" fill="#64748b" text-anchor="middle">AND</text>
    <text x="155" y="174" font-size="11" fill="#64748b" text-anchor="middle">OR</text>
    <text x="335" y="130" font-size="11" fill="#64748b" text-anchor="middle">XOR</text>

    <text x="465" y="130" fill="#2563eb" font-size="18">Y</text>
  </g>
</svg>