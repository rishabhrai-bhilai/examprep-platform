<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 420 300" width="420" height="300">
  <rect width="100%" height="100%" fill="#ffffff" rx="12"/>
  <text x="210" y="30" font-family="sans-serif" font-size="14" font-weight="bold" fill="#1e293b" text-anchor="middle">Macronutrient Energy Distribution (2000 kcal)</text>
  
  <path d="M 160,160 L 260,160 A 100,100 0 0,1 101,241 Z" fill="#3b82f6" stroke="#ffffff" stroke-width="2"/>
  <path d="M 160,160 L 101,241 A 100,100 0 0,1 65,129 Z" fill="#10b981" stroke="#ffffff" stroke-width="2"/>
  <path d="M 160,160 L 65,129 A 100,100 0 0,1 160,60 Z" fill="#f59e0b" stroke="#ffffff" stroke-width="2"/>
  <path d="M 160,160 L 160,60 A 100,100 0 0,1 255,129 Z" fill="#ef4444" stroke="#ffffff" stroke-width="2"/>
  <path d="M 160,160 L 255,129 A 100,100 0 0,1 260,160 Z" fill="#8b5cf6" stroke="#ffffff" stroke-width="2"/>

  <g font-family="sans-serif" font-size="12" fill="#334155">
    <rect x="285" y="75" width="12" height="12" fill="#3b82f6" rx="2"/>
    <text x="305" y="86">Carbs (35%)</text>
    <rect x="285" y="105" width="12" height="12" fill="#10b981" rx="2"/>
    <text x="305" y="116">Protein (20%)</text>
    <rect x="285" y="135" width="12" height="12" fill="#f59e0b" rx="2"/>
    <text x="305" y="146">Unsat Fat (20%)</text>
    <rect x="285" y="165" width="12" height="12" fill="#ef4444" rx="2"/>
    <text x="305" y="176">Sat Fat (20%)</text>
    <rect x="285" y="195" width="12" height="12" fill="#8b5cf6" rx="2"/>
    <text x="305" y="206">Trans Fat (5%)</text>
  </g>
</svg>